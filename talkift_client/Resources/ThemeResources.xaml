<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Brushes.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme-specific Resources -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource ColorBackground}"/>
            <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{StaticResource ColorBackgroundSecondary}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorCardBackground}"/>
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource ColorCardStroke}"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource ColorCardStroke}"/>
            <SolidColorBrush x:Key="ShadowBrush" Color="#20000000"/>
            <SolidColorBrush x:Key="FocusVisualBrush" Color="{StaticResource ColorAccent}"/>
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource ColorAccent}"/>
            <SolidColorBrush x:Key="TextBoxBorderBrush" Color="{StaticResource ColorCardStroke}"/>
            <SolidColorBrush x:Key="TextBoxDisabledBorderBrush" Color="#D0CECE"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource DarkColorBackground}"/>
            <SolidColorBrush x:Key="NavigationViewPaneBackground" Color="{StaticResource DarkColorBackgroundSecondary}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource DarkColorCardBackground}"/>
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{StaticResource DarkColorCardStroke}"/>
            <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource DarkColorCardStroke}"/>
            <SolidColorBrush x:Key="ShadowBrush" Color="#40000000"/>
            <SolidColorBrush x:Key="FocusVisualBrush" Color="{StaticResource DarkColorAccent}"/>
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{StaticResource DarkColorAccent}"/>
            <SolidColorBrush x:Key="TextBoxBorderBrush" Color="{StaticResource DarkColorCardStroke}"/>
            <SolidColorBrush x:Key="TextBoxDisabledBorderBrush" Color="#504F4F"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Opacity Animations -->
    <x:Double x:Key="AnimationDurationFast">0.1</x:Double>
    <x:Double x:Key="AnimationDurationNormal">0.3</x:Double>
    <x:Double x:Key="AnimationDurationSlow">0.5</x:Double>

    <!-- Backdrop Settings -->
    <x:Boolean x:Key="EnableMicaBackdrop">True</x:Boolean>
    <x:Boolean x:Key="EnableAcrylicBackdrop">False</x:Boolean>
    <x:Boolean x:Key="EnableBackdropAnimation">True</x:Boolean>

    <!-- Corner Radius Theme -->
    <CornerRadius x:Key="SmallCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ExtraLargeCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="FullCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="CircleCornerRadius">9999</CornerRadius>

    <!-- ScrollBar Style -->
    <Style x:Key="CustomScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource ForegroundSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Rectangle Fill="Transparent"/>
                        <Thumb x:Name="ThumbElement" Background="{TemplateBinding Foreground}"
                               CornerRadius="4" Width="8"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
