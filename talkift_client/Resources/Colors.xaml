<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <Color x:Key="ColorPrimary">#0078D4</Color>
    <Color x:Key="ColorPrimaryLight">#4D8FD8</Color>
    <Color x:Key="ColorPrimaryDark">#005A9E</Color>
    <Color x:Key="ColorSecondary">#0378D4</Color>
    <Color x:Key="ColorBackground">#FFFFFF</Color>
    <Color x:Key="ColorBackgroundSecondary">#F3F2F1</Color>
    <Color x:Key="ColorForeground">#201F1E</Color>
    <Color x:Key="ColorForegroundSecondary">#605E5C</Color>
    <Color x:Key="ColorForegroundTertiary">#8A8886</Color>
    <Color x:Key="ColorCardBackground">#FFFFFF</Color>
    <Color x:Key="ColorCardStroke">#C8C6C4</Color>
    <Color x:Key="ColorAccent">#0078D4</Color>
    <Color x:Key="ColorSuccess">#107C10</Color>
    <Color x:Key="ColorWarning">#D83B01</Color>
    <Color x:Key="ColorError">#E81123</Color>
    <Color x:Key="ColorInfo">#0078D4</Color>

    <!-- Dark Theme Colors -->
    <Color x:Key="DarkColorPrimary">#4D8FD8</Color>
    <Color x:Key="DarkColorPrimaryLight">#6DAFEC</Color>
    <Color x:Key="DarkColorPrimaryDark">#3A74B8</Color>
    <Color x:Key="DarkColorBackground">#1B1B1B</Color>
    <Color x:Key="DarkColorBackgroundSecondary">#2D2D2D</Color>
    <Color x:Key="DarkColorForeground">#E8E8E8</Color>
    <Color x:Key="DarkColorForegroundSecondary">#A8A8A8</Color>
    <Color x:Key="DarkColorForegroundTertiary">#808080</Color>
    <Color x:Key="DarkColorCardBackground">#2D2D2D</Color>
    <Color x:Key="DarkColorCardStroke">#404040</Color>
    <Color x:Key="DarkColorAccent">#4D8FD8</Color>
    <Color x:Key="DarkColorSuccess">#4EC94E</Color>
    <Color x:Key="DarkColorWarning">#E8713A</Color>
    <Color x:Key="DarkColorError">#F14C4C</Color>
    <Color x:Key="DarkColorInfo">#4D8FD8</Color>

    <!-- Message Bubble Colors -->
    <Color x:Key="ColorBubbleSent">#0078D4</Color>
    <Color x:Key="ColorBubbleSentForeground">#FFFFFF</Color>
    <Color x:Key="ColorBubbleReceived">#F3F2F1</Color>
    <Color x:Key="ColorBubbleReceivedForeground">#201F1E</Color>
    <Color x:Key="DarkColorBubbleSent">#0078D4</Color>
    <Color x:Key="DarkColorBubbleSentForeground">#FFFFFF</Color>
    <Color x:Key="DarkColorBubbleReceived">#2D2D2D</Color>
    <Color x:Key="DarkColorBubbleReceivedForeground">#E8E8E8</Color>

    <!-- Status Colors -->
    <Color x:Key="ColorOnline">#107C10</Color>
    <Color x:Key="ColorAway">#D83B01</Color>
    <Color x:Key="ColorBusy">#C50A0A</Color>
    <Color x:Key="ColorOffline">#808080</Color>
    <Color x:Key="DarkColorOnline">#4EC94E</Color>
    <Color x:Key="DarkColorAway">#E8713A</Color>
    <Color x:Key="DarkColorBusy">#F14C4C</Color>
    <Color x:Key="DarkColorOffline">#808080</Color>
</ResourceDictionary>
