<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="SmallFontSize">12</x:Double>
    <x:Double x:Key="MediumFontSize">14</x:Double>
    <x:Double x:Key="LargeFontSize">16</x:Double>
    <x:Double x:Key="TitleFontSize">18</x:Double>
    <x:Double x:Key="DisplayFontSize">24</x:Double>
    <x:Double x:Key="ExtraLargeFontSize">32</x:Double>

    <x:Double x:Key="ExtraSmallCornerRadius">4</x:Double>
    <x:Double x:Key="SmallCornerRadius">8</x:Double>
    <x:Double x:Key="MediumCornerRadius">12</x:Double>
    <x:Double x:Key="LargeCornerRadius">16</x:Double>
    <x:Double x:Key="ExtraLargeCornerRadius">20</x:Double>

    <Thickness x:Key="SmallPadding">4,2</Thickness>
    <Thickness x:Key="MediumPadding">8,4</Thickness>
    <Thickness x:Key="LargePadding">12,8</Thickness>
    <Thickness x:Key="ExtraLargePadding">16,12</Thickness>
    <Thickness x:Key="PagePadding">24</Thickness>

    <Thickness x:Key="BubblePadding">12,8</Thickness>
    <Thickness x:Key="BubbleMargin">4,2</Thickness>

    <x:Double x:Key="AvatarSizeSmall">32</x:Double>
    <x:Double x:Key="AvatarSizeMedium">36</x:Double>
    <x:Double x:Key="AvatarSizeLarge">40</x:Double>
    <x:Double x:Key="AvatarSizeExtraLarge">80</x:Double>

    <x:Double x:Key="MessageBubbleMaxWidth">560</x:Double>
    <x:Double x:Key="MessageBubbleMinWidth">120</x:Double>

    <x:Double x:Key="ChatInputCornerRadius">20</x:Double>
    <x:Double x:Key="ButtonCornerRadius">8</x:Double>
    <x:Double x:Key="CardCornerRadius">12</x:Double>

    <FontWeight x:Key="LightWeight">Normal</FontWeight>
    <FontWeight x:Key="SemiBoldWeight">SemiBold</FontWeight>
    <FontWeight x:Key="BoldWeight">Bold</FontWeight>

    <FontStyle x:Key="ItalicStyle">Italic</FontStyle>
</ResourceDictionary>
