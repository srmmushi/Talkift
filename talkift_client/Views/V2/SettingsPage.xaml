<Page
    x:Class="Talkift.Client.Views.V2.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Padding="0,12" Spacing="2">
            <Button x:Name="NavAppearance" Style="{StaticResource IconButtonStyle}"
                    Content="Appearance" Click="NavAppearance_Click" Padding="16,8"
                    HorizontalAlignment="Stretch" CornerRadius="4"/>
            <Button x:Name="NavServerMgmt" Style="{StaticResource IconButtonStyle}"
                    Content="Server" Click="NavServerMgmt_Click" Padding="16,8"
                    HorizontalAlignment="Stretch" CornerRadius="4"/>
            <Button x:Name="NavStorage" Style="{StaticResource IconButtonStyle}"
                    Content="Storage" Click="NavStorage_Click" Padding="16,8"
                    HorizontalAlignment="Stretch" CornerRadius="4"/>
            <Button x:Name="NavAbout" Style="{StaticResource IconButtonStyle}"
                    Content="About" Click="NavAbout_Click" Padding="16,8"
                    HorizontalAlignment="Stretch" CornerRadius="4"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.ActiveSection}" FontSize="20" FontWeight="SemiBold"/>

                <StackPanel x:Name="AppearanceSection" Spacing="12">
                    <TextBlock Text="Theme" FontSize="14" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="DarkModeToggle" Header="Dark Mode"
                                  IsOn="{x:Bind ViewModel.IsDarkMode, Mode=TwoWay}"/>
                    <TextBlock Text="Window Opacity" FontSize="14" FontWeight="SemiBold"/>
                    <Slider x:Name="OpacitySlider" Value="{x:Bind ViewModel.Opacity, Mode=TwoWay}"
                            Minimum="0.3" Maximum="1.0" StepFrequency="0.1"
                            Width="300"/>
                    <TextBlock Text="Animations" FontSize="14" FontWeight="SemiBold"/>
                    <ToggleSwitch x:Name="AnimationToggle" Header="Enable"
                                  IsOn="{x:Bind ViewModel.EnableAnimations, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel x:Name="ServerSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Official Server" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox x:Name="ServerAddrBox" Text="{x:Bind ViewModel.OfficialServerAddress, Mode=TwoWay}"
                             PlaceholderText="Server address" CornerRadius="4" Padding="8,4"/>
                    <NumberBox x:Name="ServerPortBox" Value="{x:Bind ViewModel.OfficialServerPort, Mode=TwoWay}"
                               Minimum="1" Maximum="65535" Width="120"/>
                    <Button Content="Save" Click="SaveServerButton_Click"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Padding="12,8"/>
                </StackPanel>

                <StackPanel x:Name="StorageSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Data Path" FontSize="14" FontWeight="SemiBold"/>
                    <TextBox x:Name="StoragePathBox" Text="{x:Bind ViewModel.StoragePath}"
                             IsReadOnly="True" CornerRadius="4" Padding="8,4"/>
                    <Button Content="Change" Click="ChangeStoragePath_Click"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Padding="12,8"/>
                    <Button Content="Open Log Folder" Click="OpenLogFolder_Click"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Padding="12,8"/>
                </StackPanel>

                <Button Content="Save" Click="SaveButton_Click"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="4"
                        Padding="16,8" HorizontalAlignment="Left"
                        Visibility="Collapsed" x:Name="SaveButton"/>
                <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.StatusMessage}"
                           FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
