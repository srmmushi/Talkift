<Page
    x:Class="Talkift.Client.Views.V2.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Talkift.Client.Models.V2"
    xmlns:controls="using:Talkift.Client.Views.Controls"
    xmlns:views="using:Talkift.Client.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:ChatHeader x:Name="ChatHeaderCtrl" Grid.Row="0"/>

        <views:PinMessagePanel x:Name="PinPanel" Grid.Row="1" VerticalAlignment="Top" Margin="16,4"/>

        <ListView Grid.Row="1" x:Name="MessagesList" Padding="16,8"
                  SelectionMode="None" ItemsSource="{x:Bind ViewModel.Messages}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.IsDeferredScrollingEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessageModel">
                    <controls:MessageBubble Message="{x:Bind}" IsMine="{x:Bind IsMine}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:TypingIndicator x:Name="TypingIndicator" Grid.Row="2"
                                        Visibility="Collapsed" Margin="16,0"/>

        <views:ReplyBar x:Name="ReplyBar" Grid.Row="2" VerticalAlignment="Bottom"/>

        <Grid Grid.Row="2" Padding="16,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <views:QuickActionToolbar x:Name="QuickToolbar" Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" x:Name="MessageInput"
                         Text="{x:Bind ViewModel.MessageText, Mode=TwoWay}"
                         PlaceholderText="Type a message..."
                         CornerRadius="20" Padding="12,8"
                         KeyDown="MessageInput_KeyDown"
                         TextChanged="MessageInput_TextChanged"
                         AcceptsReturn="True"/>

                <Button Grid.Column="1" x:Name="SendButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="8,0,0,0" CornerRadius="20"
                        Padding="16,8" Click="SendButton_Click" IsEnabled="False">
                    <FontIcon Glyph="&#xE77D;" FontSize="16"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
