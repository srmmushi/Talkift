<Page
    x:Class="Talkift.Client.Views.V2.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Talkift.Client.Views.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <TextBlock Text="Profile" FontSize="16" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" Width="400">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <controls:AvatarControl Width="80" Height="80"
                                            Username="{x:Bind ViewModel.Profile.Username}"/>
                    <TextBlock Text="{x:Bind ViewModel.Profile.Username}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Bind ViewModel.Profile.Email}" FontSize="13"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Status" FontSize="14" FontWeight="SemiBold"/>
                        <ComboBox x:Name="StatusCombo" SelectionChanged="StatusCombo_SelectionChanged">
                            <ComboBoxItem Content="Online"/>
                            <ComboBoxItem Content="Away"/>
                            <ComboBoxItem Content="Busy"/>
                            <ComboBoxItem Content="Offline"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Bio" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="BioBox" Text="{x:Bind ViewModel.Bio, Mode=TwoWay}"
                                 PlaceholderText="Tell us about yourself" CornerRadius="4"
                                 Padding="8,4"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Signature" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox x:Name="SignatureBox" Text="{x:Bind ViewModel.Signature, Mode=TwoWay}"
                                 PlaceholderText="Your signature" CornerRadius="4" Padding="8,4"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Save" Click="SaveButton_Click"
                                Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Padding="12,8"/>
                        <Button Content="Cancel" Click="CancelButton_Click"
                                Style="{StaticResource IconButtonStyle}" CornerRadius="4" Padding="12,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
