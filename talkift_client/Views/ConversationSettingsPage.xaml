<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Talkift.Client.Views.ConversationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Talkift.Client.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

            <Button Click="BackButton_Click"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock x:Name="BackToChatText" Text="Back to Chat"/>
                </StackPanel>
            </Button>

            <StackPanel Spacing="8">
                <TextBlock x:Name="InfoHeader"
                           Text="Info"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Border Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NameLabel" Text="Name" FontWeight="SemiBold" Grid.Column="0"/>
                            <TextBlock x:Name="NameText" Grid.Column="1" Text="{x:Bind ConversationName, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TypeLabel" Text="Type" FontWeight="SemiBold" Grid.Column="0"/>
                            <TextBlock x:Name="TypeText" Grid.Column="1" Text="{x:Bind ConversationType, Mode=OneWay}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CreatedLabel" Text="Created" FontWeight="SemiBold" Grid.Column="0"/>
                            <TextBlock x:Name="CreatedText" Grid.Column="1" Text="{x:Bind ConversationCreated, Mode=OneWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="MembersHeader"
                           Text="Members"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ListView x:Name="MembersList"
                          MaxHeight="300"
                          SelectionMode="None"
                          ItemsSource="{x:Bind Members}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="28" Height="28"
                                         Fill="{ThemeResource AccentColor}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           FontWeight="SemiBold"/>
                                <Button Grid.Column="2"
                                        x:Name="MemberActionButton"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        FontSize="12"
                                        Click="MemberActionButton_Click"
                                        Tag="{Binding}">
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Spacing="8"
                        Visibility="{x:Bind IsDndVisible, Mode=OneWay}">
                <TextBlock x:Name="NotificationsHeader"
                           Text="Notifications"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ToggleSwitch x:Name="DndToggle"
                              Header="Do Not Disturb"
                              Toggled="DndToggle_Toggled"
                              OffContent="On"
                              OnContent="Off"/>
            </StackPanel>

            <StackPanel Spacing="8"
                        Visibility="{x:Bind IsOwnerVisible, Mode=OneWay}">
                <TextBlock x:Name="AdminHeader"
                           Text="Admin Actions"
                           Style="{StaticResource SubtitleTextBlockStyle}"/>
                <Button x:Name="DeleteGroupButton"
                        Content="Delete Group"
                        Click="DeleteGroupButton_Click"
                        Background="#E81123"
                        Foreground="White"
                        HorizontalAlignment="Left"
                        CornerRadius="4"/>
            </StackPanel>

            <Button x:Name="LeaveButton"
                    Content="Leave"
                    Click="LeaveButton_Click"
                    Background="#E81123"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    CornerRadius="4"/>

            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
