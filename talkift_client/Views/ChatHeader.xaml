<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Talkift.Client.Views.ChatHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="48" Padding="12,0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                    PointerPressed="ChatArea_PointerPressed">
            <Ellipse Width="36" Height="36"
                     Fill="{ThemeResource SystemControlBackgroundAccentBrush}"
                     VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ChatNameText" Text="Chat"
                           FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="ChatStatusText" Text="Online"
                           FontSize="11"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center">
            <Button x:Name="SearchButton" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Search" Click="SearchButton_Click">
                <FontIcon Glyph="&#xE721;" FontSize="16"/>
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Pinned Messages" Click="PinButton_Click">
                <FontIcon Glyph="&#xE840;" FontSize="16"/>
            </Button>
            <Button x:Name="MembersButton" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Members" Click="MembersButton_Click">
                <FontIcon Glyph="&#xE779;" FontSize="16"/>
            </Button>
            <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More" Click="MoreButton_Click">
                <FontIcon Glyph="&#xE712;" FontSize="16"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
