<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Talkift.Client.Views.UserProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="280">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="12" Padding="16">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
            <Ellipse Width="64" Height="64"
                     Fill="{ThemeResource SystemControlBackgroundAccentBrush}"
                     HorizontalAlignment="Center"/>
            <TextBlock x:Name="UsernameText" Text="Username"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Online"
                       FontSize="12"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"/>
            <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>
            <StackPanel Spacing="6">
                <TextBlock x:Name="EmailLabel" Text="Email"
                           FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="EmailText" Text=""
                           FontSize="13"/>
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock x:Name="JoinedLabel" Text="Joined"
                           FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="JoinedText" Text=""
                           FontSize="13"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
