<?xml version="1.0" encoding="utf-8"?>
<MenuFlyout
    x:Class="Talkift.Client.Views.MessageContextMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <MenuFlyoutItem x:Name="CopyItem" Text="Copy" Tag="copy" Click="MenuItem_Click">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
    <MenuFlyoutItem x:Name="ReplyItem" Text="Reply" Tag="reply" Click="MenuItem_Click">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE72D;" FontSize="14"/>
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
    <MenuFlyoutItem x:Name="ForwardItem" Text="Forward" Tag="forward" Click="MenuItem_Click">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
    <MenuFlyoutItem x:Name="PinItem" Text="Pin" Tag="pin" Click="MenuItem_Click">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE840;" FontSize="14"/>
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
    <MenuFlyoutItem x:Name="EditItem" Text="Edit" Tag="edit" Click="MenuItem_Click">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="DeleteItem" Text="Delete" Tag="delete" Click="MenuItem_Click"
                    Foreground="Red">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
</MenuFlyout>
