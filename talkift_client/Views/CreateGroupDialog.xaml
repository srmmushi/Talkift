<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Talkift.Client.Views.CreateGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="DialogRoot"
    Title="Create Group"
    PrimaryButtonText="Create"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    Loaded="OnLoaded">

    <StackPanel Spacing="12" Width="350">
        <TextBox x:Name="GroupNameInput"
                 Header="Group Name"
                 PlaceholderText="Enter group name"
                 TextChanged="GroupNameInput_TextChanged"/>

        <TextBlock x:Name="SelectMembersText"
                   Text="Select members from Public Group:"
                   FontSize="12"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

        <ListView x:Name="MemberListView"
                  MaxHeight="250"
                  SelectionMode="Multiple"
                  SelectionChanged="MemberListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Grid Padding="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="28" Height="28"
                                 Fill="{ThemeResource AccentColor}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="ErrorBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True"/>
    </StackPanel>
</ContentDialog>
