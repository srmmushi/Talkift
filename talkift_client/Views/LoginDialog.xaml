<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Talkift.Client.Views.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="380">

    <StackPanel Padding="8" Spacing="16">
        <TextBlock Text="Login to Server"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <InfoBar x:Name="ErrorInfoBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True"
                 HorizontalAlignment="Stretch"
                 Margin="0,0,0,8"/>

        <TextBox x:Name="UsernameBox"
                 Header="Username"
                 PlaceholderText="Enter your username"
                 MaxLength="32"/>

        <Grid>
            <PasswordBox x:Name="PasswordBox"
                         Header="Password"
                         PlaceholderText="Enter your password"
                         MaxLength="64"/>

            <Button x:Name="TogglePasswordBtn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,8"
                    Padding="6,2"
                    Click="TogglePassword_Click"
                    ToolTip="Show/Hide password"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon x:Name="TogglePasswordIcon" Glyph="&#xE890;" FontSize="14"/>
            </Button>
        </Grid>

        <CheckBox x:Name="RememberPasswordCheckBox"
                  Content="Remember password"
                  IsChecked="True"/>

        <CheckBox x:Name="OfflineLoginCheckBox"
                  Content="Offline login (no password required)"
                  Checked="OfflineLoginCheckBox_Checked"
                  Unchecked="OfflineLoginCheckBox_Unchecked"/>

        <Button x:Name="LoginButton"
                Content="Login"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Padding="16,10"
                CornerRadius="8"
                Click="LoginButton_Click"/>

        <Button x:Name="OfflineLoginButton"
                Content="Offline Login"
                HorizontalAlignment="Stretch"
                Padding="16,10"
                CornerRadius="8"
                Click="OfflineLoginButton_Click"
                Visibility="Collapsed"/>

        <HyperlinkButton x:Name="RegisterLink"
                         HorizontalAlignment="Center"
                         Click="RegisterLink_Click">
            <TextBlock>
                <Run Text="Don't have an account?"/>
                <Run Text=" Register" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}"/>
            </TextBlock>
        </HyperlinkButton>

        <ProgressRing x:Name="LoadingRing"
                      IsActive="False"
                      HorizontalAlignment="Center"
                      Width="30" Height="30"/>
    </StackPanel>
</UserControl>
