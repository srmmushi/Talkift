<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Talkift.Client.Views.PinMessagePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Visibility="Collapsed" MaxHeight="200">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1" Padding="12,8">
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE840;" FontSize="14"
                          Foreground="{ThemeResource SystemAccentColor}"/>
                <TextBlock x:Name="TitleText" Text="Pinned Messages"
                           FontSize="12" FontWeight="SemiBold"/>
                <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" Click="CloseButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </StackPanel>
            <ListView x:Name="PinnedMessagesList" SelectionMode="None"
                      MaxHeight="160" Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                   FontSize="12" Padding="4,2"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
