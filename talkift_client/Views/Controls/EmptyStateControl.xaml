<Page
    x:Class="Talkift.Client.Views.Controls.EmptyStateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon x:Name="EmptyIcon" Glyph="&#xE7F3;" FontSize="48"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBlock x:Name="EmptyTitle" Text="No items"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptySubtitle" Text="Start a conversation or group"
                       FontSize="13"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="280"/>
            <Button x:Name="ActionButton" Style="{StaticResource AccentButtonStyle}"
                    Content="Get Started" Click="ActionButton_Click"
                    CornerRadius="8" Padding="16,8" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
