<UserControl
    x:Class="Talkift.Client.Views.Controls.MessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="MessageBubbleSentStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="12,12,4,12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>

        <Style x:Key="MessageBubbleReceivedStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="12,12,12,4"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>

        <Style x:Key="MessageBubbleSystemStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MaxWidth" Value="400"/>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Bubble">
        <TextBlock Text="{x:Bind Message.Content, Mode=OneWay}" TextWrapping="Wrap"/>
    </Border>
</UserControl>