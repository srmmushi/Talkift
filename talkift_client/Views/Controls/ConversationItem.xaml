<Page
    x:Class="Talkift.Client.Views.Controls.ConversationItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Talkift.Client.Views.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="12,8" MinHeight="64"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          PointerPressed="Grid_PointerPressed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <controls:AvatarControl Grid.Column="0" Width="40" Height="40"
                                Username="{x:Bind Model.Name}"/>

        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
                <TextBlock Text="{x:Bind Model.Name}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Model.GetFormattedTime()}" FontSize="11"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="SpaceBetween"
                        Margin="0,2,0,0">
                <TextBlock Text="{x:Bind Model.DisplaySubtitle}" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxWidth="200"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Model.UnreadCount, StringFormat='{0}'}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="White" Visibility="{x:Bind Model.HasUnread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <controls:ConnectionStatusBadge Status="{x:Bind Model.IsGroup, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
