<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Talkift.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:Models="using:Talkift.Client.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,16">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Settings"
                       Style="{StaticResource TitleLargeTextBlockStyle}"/>

            <muxc:TabView x:Name="SettingsTabs"
                          IsAddTabButtonVisible="False">
                <muxc:TabViewItem Header="General" IsSelected="True">
                    <Grid Padding="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Login Servers"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,0,0,12"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Manage registration and login servers"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                            <Button Grid.Column="1"
                                    Content="Add Server"
                                    Click="AddLoginServer_Click"
                                    CornerRadius="4"/>
                        </Grid>

                        <ListView Grid.Row="2"
                                  x:Name="LoginServerList"
                                  ItemsSource="{x:Bind ViewModel.LoginServers}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="Models:LoginServer">
                                    <Grid Padding="12,10" CornerRadius="8"
                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind Address}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text=":"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{x:Bind Port}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4"
                                                    Padding="8,2"
                                                    Background="{ThemeResource SystemControlBackgroundAccentBrush}">
                                                <TextBlock Text="{x:Bind Type}"
                                                           Foreground="White"
                                                           FontSize="11"/>
                                            </Border>
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    Click="DeleteLoginServer_Click"
                                                    Tag="{x:Bind}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="About">
                    <StackPanel Padding="24" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE716;" FontSize="64" HorizontalAlignment="Center"/>

                        <TextBlock Text="Talkift"
                                   Style="{StaticResource TitleLargeTextBlockStyle}"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="A modern communication platform"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   FontSize="12"
                                   Margin="0,24,0,0">
                            <Run Text="Version"/>
                            <Run Text="{x:Bind ViewModel.AppVersion}"/>
                        </TextBlock>

                        <TextBlock Text="Copyright 2026 Talkift Team"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   HorizontalAlignment="Center"
                                   FontSize="12"/>
                    </StackPanel>
                </muxc:TabViewItem>
            </muxc:TabView>
        </StackPanel>
    </ScrollViewer>
</Page>
