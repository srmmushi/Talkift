<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Talkift.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="0" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0" HorizontalAlignment="Left">
            <StackPanel Padding="12,16" Spacing="2" HorizontalAlignment="Left">
                <TextBlock x:Name="TitleText"
                           Text="Settings"
                           FontSize="20" FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <Button x:Name="NavAppearance" Click="NavAppearance_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" CornerRadius="6" Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" FontSize="16"/>
                        <TextBlock x:Name="NavAppearanceText" Text="Appearance" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button x:Name="NavServerMgmt" Click="NavServerMgmt_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" CornerRadius="6" Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                        <TextBlock x:Name="NavServerMgmtText" Text="Server Management" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button x:Name="NavOfficial" Click="NavOfficial_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" CornerRadius="6" Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE716;" FontSize="16"/>
                        <TextBlock x:Name="NavOfficialText" Text="Official Server" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button x:Name="NavStorage" Click="NavStorage_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" CornerRadius="6" Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                        <TextBlock x:Name="NavStorageText" Text="Storage" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>

                <Button x:Name="NavAbout" Click="NavAbout_Click"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Padding="10,8" CornerRadius="6" Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontSize="16"/>
                        <TextBlock x:Name="NavAboutText" Text="About" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel x:Name="ContentPanel" Spacing="20" MaxWidth="500" HorizontalAlignment="Left">

                <Border x:Name="AppearanceSection" Style="{StaticResource SettingsSectionCard}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AppearanceHeader" Text="Appearance" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AppearanceDesc" Text="Customize the look and feel" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="BackdropLabel" Text="Window Backdrop" FontSize="13" FontWeight="SemiBold"/>
                            <ComboBox x:Name="BackdropComboBox" MinWidth="200" Padding="10,6" CornerRadius="6"
                                      SelectionChanged="BackdropComboBox_SelectionChanged"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="OpacityLabel" Text="Window Opacity" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       x:Name="OpacityValueText" Text="100%"/>
                            <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100"
                                    StepFrequency="5" ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="LanguageLabel" Text="Language" FontSize="13" FontWeight="SemiBold"/>
                            <ComboBox x:Name="LanguageComboBox" MinWidth="200" Padding="10,6" CornerRadius="6"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ServerMgmtSection" Style="{StaticResource SettingsSectionCard}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="ServerMgmtHeader" Text="Server Management" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ServerMgmtDesc" Text="Configure server connection settings" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="AutoCheckLabel" Text="Auto-check server status" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AutoCheckDesc" Text="Automatically check if servers are online" FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoCheckToggle" Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.AutoCheckServerStatus, Mode=TwoWay}"
                                          Toggled="AutoCheckToggle_Toggled"/>
                        </Grid>

                        <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:Name="TimeoutLabel" Text="Connection timeout (seconds)" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TimeoutDesc" Text="Maximum time to wait for server response" FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <NumberBox x:Name="TimeoutNumberBox" Grid.Column="1"
                                       Value="{x:Bind ViewModel.ConnectionTimeout, Mode=TwoWay}"
                                       Minimum="3" Maximum="60" Width="100" CornerRadius="6"
                                       ValueChanged="TimeoutNumberBox_ValueChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="OfficialSection" Style="{StaticResource SettingsSectionCard}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="OfficialHeader" Text="Official Server" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OfficialDesc" Text="Configure the official Talkift server" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBox x:Name="OfficialAddrBox" Header="Server Address" PlaceholderText="47.113.216.177"
                                     CornerRadius="4"/>
                            <NumberBox x:Name="OfficialPortBox" Header="Port" Value="8001" Minimum="1" Maximum="65535"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="OfficialEmailCheck" Content="Support Email Login" IsChecked="True"/>
                                <CheckBox x:Name="OfficialOfflineCheck" Content="Support Offline Login" IsChecked="True"/>
                            </StackPanel>
                            <Button x:Name="SaveOfficialButton" Content="Save" Click="SaveOfficialButton_Click"
                                    Style="{StaticResource AccentButtonStyle}" Padding="14,6" CornerRadius="6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="StorageSection" Style="{StaticResource SettingsSectionCard}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StorageHeader" Text="Storage" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StorageDesc" Text="Configure data and log storage paths" FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="StoragePathLabel" Text="Data Storage Path" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StoragePathValue" Text="" FontSize="11"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="ChangeStoragePathButton" Content="Change" Click="ChangeStoragePath_Click"
                                        Padding="10,4" CornerRadius="4"/>
                            </Grid>

                            <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:Name="LogPathLabel" Text="Log Storage Path" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LogPathValue" Text="" FontSize="11"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="OpenLogFolderButton" Content="Open" Click="OpenLogFolder_Click"
                                        Padding="10,4" CornerRadius="4"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="AboutSection" Style="{StaticResource SettingsSectionCard}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="15"
                                Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" FontSize="28" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="Talkift" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="AboutDesc" Text="A modern communication platform"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <Border Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="11">
                                <Run x:Name="VersionLabel" Text="Version"/>
                                <Run Text="{x:Bind ViewModel.AppVersion}"/>
                            </TextBlock>
                            <TextBlock x:Name="CopyrightText" Text="Copyright 2026 Talkift Team"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       HorizontalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="StatusInfoBar" Severity="Success" IsOpen="False" IsClosable="True"
                         CornerRadius="6" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
