<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Talkift.Client.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Talkift.Client.Models"
    xmlns:views="using:Talkift.Client.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:ChatHeader x:Name="ChatHeaderCtrl" Grid.Row="0"
                          ChatClicked="ChatHeaderCtrl_ChatClicked"
                          SearchClicked="ChatHeaderCtrl_SearchClicked"
                          PinClicked="ChatHeaderCtrl_PinClicked"
                          MembersClicked="ChatHeaderCtrl_MembersClicked"
                          MoreClicked="ChatHeaderCtrl_MoreClicked"/>

        <ListView Grid.Row="1"
                  x:Name="MessagesList"
                  Padding="16,8"
                  SelectionMode="None"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ItemsSource="{x:Bind ViewModel.Messages}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Padding="0,3" HorizontalAlignment="Stretch">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copy" Click="MsgCtx_Copy"/>
                                <MenuFlyoutItem Text="Reply" Click="MsgCtx_Reply"/>
                                <MenuFlyoutItem Text="Pin" Click="MsgCtx_Pin"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="Delete" Click="MsgCtx_Delete" Foreground="Red"/>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1"
                              HorizontalAlignment="Right"
                              x:Name="MineBubble"
                              MaxWidth="400">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#0078D4"
                                    CornerRadius="12,12,4,12"
                                    Padding="12,8"
                                    HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind Content}"
                                           Foreground="White"
                                           TextWrapping="Wrap"
                                           FontSize="14"/>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Spacing="6"
                                        Margin="4,2,0,0">
                                <TextBlock Text="{x:Bind SenderName}"
                                           FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind TimeDisplay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    x:Name="OtherBubble"
                                    MaxWidth="400">
                            <Border CornerRadius="12,12,12,4"
                                    Padding="12,8"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind SenderName}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               Margin="0,0,0,2"/>
                                    <TextBlock Text="{x:Bind Content}"
                                               TextWrapping="Wrap"
                                               FontSize="14"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{x:Bind TimeDisplay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,4"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="1"
                   x:Name="EmptyChatText"
                   Text="No messages yet."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                   Visibility="Collapsed"/>

        <views:MessageSearchPanel x:Name="SearchPanel" Grid.Row="1"
                                  VerticalAlignment="Top" Margin="16,8"/>

        <views:PinMessagePanel x:Name="PinPanel" Grid.Row="1"
                               VerticalAlignment="Top" Margin="16,8"/>

        <InfoBar Grid.Row="1"
                 x:Name="ErrorInfoBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True"
                 VerticalAlignment="Top"
                 Margin="16,8"/>

        <views:TypingIndicator x:Name="TypingIndicator" Grid.Row="2"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="16,0"/>

        <views:ReplyBar x:Name="ReplyBar" Grid.Row="2"
                        VerticalAlignment="Bottom"/>

        <views:FileAttachmentPreview x:Name="FilePreview" Grid.Row="2"
                                     VerticalAlignment="Bottom"/>

        <views:VoiceRecorder x:Name="VoiceRecorder" Grid.Row="2"
                             VerticalAlignment="Bottom"/>

        <Grid Grid.Row="2" Padding="16,8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <views:QuickActionToolbar x:Name="QuickToolbar" Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="MessageInput"
                         PlaceholderText="Type a message..."
                         CornerRadius="20"
                         Padding="12,8"
                         KeyDown="MessageInput_KeyDown"
                         TextChanged="MessageInput_TextChanged"
                         AcceptsReturn="False"/>

                <Button Grid.Column="1"
                        x:Name="SendButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="8,0,0,0"
                        CornerRadius="20"
                        Padding="16,8"
                        Click="SendButton_Click"
                        IsEnabled="False">
                    <FontIcon Glyph="&#xE77D;" FontSize="16"/>
                </Button>
            </Grid>
        </Grid>

        <Button x:Name="EmojiFlyoutOwner" Visibility="Collapsed">
            <Button.Flyout>
                <Flyout x:Name="EmojiFlyout">
                    <views:EmojiPicker x:Name="EmojiPicker"/>
                </Flyout>
            </Button.Flyout>
        </Button>

        <views:MessageReactionBar x:Name="ReactionBar" Grid.Row="1"
                                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                  Margin="0,0,0,8"/>
    </Grid>
</Page>
