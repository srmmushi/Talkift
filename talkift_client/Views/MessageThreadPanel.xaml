<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Talkift.Client.Views.MessageThreadPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="320" Visibility="Collapsed">

    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,8">
            <TextBlock x:Name="TitleText" Text="Thread"
                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}"
                    HorizontalAlignment="Right" Click="CloseButton_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Height="1"/>

        <ListView Grid.Row="2" x:Name="ThreadMessages" SelectionMode="None" Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Padding="8,6" Margin="0,2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"/>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" Padding="8">
            <TextBox x:Name="ReplyInput" PlaceholderText="Reply..."
                     CornerRadius="4" Padding="8,4"
                     KeyDown="ReplyInput_KeyDown"/>
        </Grid>
    </Grid>
</UserControl>
